      "custom_logic_action": "<p>const TAG = \"[CL-ACTION][MIG-DIE-BONUS]\";</p><p>const p = __PAYLOAD;</p><p>if (!p) {</p><p>console.warn(TAG, \"Missing __PAYLOAD\");</p><p>return;</p><p>}</p><p>// Preferred new helper method from your updated custom logic system</p><p>let attackerActor = null;</p><p>if (context?.helpers?.getAttackerActor) {</p><p>attackerActor = await context.helpers.getAttackerActor();</p><p>}</p><p>if (!attackerActor) {</p><p>const attackerDoc = await fromUuid(p?.meta?.attackerUuid ?? p?.attackerUuid ?? \"\");</p><p>attackerActor = attackerDoc?.actor ?? attackerDoc;</p><p>}</p><p>if (!attackerActor) {</p><p>console.warn(TAG, \"Could not resolve attacker actor.\");</p><p>return;</p><p>}</p><p>// Pull MIG die size from actor data</p><p>const migRaw = attackerActor?.system?.props?.mig_current ?? \"0\";</p><p>// Supports values like:</p><p>// \"d6\" -&gt; 6</p><p>// \"D10\" -&gt; 10</p><p>// \"10\" -&gt; 10</p><p>// 12 -&gt; 12</p><p>const migDieSize = (() =&gt; {</p><p>if (typeof migRaw === \"number\") return Math.max(0, migRaw);</p><p>const text = String(migRaw).trim();</p><p>const dMatch = text.match(/d\\s*(\\d+)/i);</p><p>if (dMatch) return Math.max(0, Number(dMatch[1]) || 0);</p><p>const numMatch = text.match(/(\\d+)/);</p><p>if (numMatch) return Math.max(0, Number(numMatch[1]) || 0);</p><p>return 0;</p><p>})();</p><p>// Add that die size as bonus damage</p><p>p.advPayload ??= {};</p><p>const bonusBefore = Number(p.advPayload.bonus ?? 0) || 0;</p><p>p.advPayload.bonus = bonusBefore + migDieSize;</p><p>// Optional debug/meta markers</p><p>p.meta ??= {};</p><p>p.meta.migDieSizeBonus = migDieSize;</p><p>console.log(TAG, \"APPLIED\", {</p><p>attacker: attackerActor?.name,</p><p>migRaw,</p><p>migDieSize,</p><p>bonusBefore,</p><p>bonusAfter: p.advPayload.bonus</p><p>});</p><p>if (context?.log) {</p><p>context.log(\"Applied MIG die size bonus damage\", {</p><p>attacker: attackerActor?.name,</p><p>migRaw,</p><p>migDieSize,</p><p>bonusBefore,</p><p>bonusAfter: p.advPayload.bonus</p><p>});</p><p>}</p>",
