      "class": "Esper",
      "cost": "X MP",
      "custom_logic_action": "<p>(async () =&gt; {</p><p>const TAG = \"[CL-ACTION][Thermokinesis]\";</p><p>const p = __PAYLOAD;</p><p>if (!p) return console.warn(TAG, \"Missing __PAYLOAD\");</p><p>// --------------------------------------------------</p><p>// Resolve caster</p><p>// --------------------------------------------------</p><p>const attackerDoc = await fromUuid(</p><p>p?.meta?.attackerUuid ??</p><p>p?.attackerUuid ??</p><p>\"\"</p><p>);</p><p>const attackerActor = attackerDoc?.actor ?? attackerDoc;</p><p>if (!attackerActor) {</p><p>console.warn(TAG, \"Could not resolve attacker actor.\");</p><p>return;</p><p>}</p><p>// --------------------------------------------------</p><p>// Read Brainwave Clock</p><p>// --------------------------------------------------</p><p>const clockRaw = attackerActor?.system?.props?.clock_brainwave ?? 0;</p><p>const brainwave = Math.max(0, parseInt(clockRaw, 10) || 0);</p><p>// Psychic Gifts cost rule: minimum 5 MP</p><p>const mpCost = Math.max(5, brainwave * 5);</p><p>// --------------------------------------------------</p><p>// Apply dynamic cost override for ResourceGate</p><p>// --------------------------------------------------</p><p>p.meta = p.meta || {};</p><p>p.meta.costRawOverride = `${mpCost} mp`;</p><p>p.meta.costRawFinal = `${mpCost} mp`;</p><p>console.log(TAG, \"MP COST UPDATED\", {</p><p>attacker: attackerActor?.name,</p><p>brainwave,</p><p>mpCost,</p><p>costRawOverride: p?.meta?.costRawOverride,</p><p>costRawFinal: p?.meta?.costRawFinal</p><p>});</p><p>})();</p>",
      "custom_logic_resolution": "<p>const TAG = \"[CL-RES][THERMOKINESIS][BRAINWAVE]\";</p><p>const p = __PAYLOAD ?? {};</p><p>const attackerUuid = p?.meta?.attackerUuid ?? p?.attackerUuid ?? \"\";</p><p>if (!attackerUuid) {</p><p>console.warn(TAG, \"Missing attacker UUID in payload.\", { payload: p });</p><p>return;</p><p>}</p><p>const attackerDoc = await fromUuid(attackerUuid);</p><p>const attackerActor = attackerDoc?.actor ?? attackerDoc;</p><p>if (!attackerActor) {</p><p>console.warn(TAG, \"Could not resolve attacker actor.\", { attackerUuid });</p><p>return;</p><p>}</p><p>const currentClock = Math.max(</p><p>0,</p><p>Number(attackerActor.system?.props?.clock_brainwave ?? 0) || 0</p><p>);</p><p>const newClock = Math.min(4, currentClock + 1);</p><p>await attackerActor.update({</p><p>\"system.props.clock_brainwave\": String(newClock)</p><p>});</p><p>console.log(TAG, \"Brainwave Clock updated.\", {</p><p>actor: attackerActor.name,</p><p>before: currentClock,</p><p>after: newClock</p><p>});</p>",
