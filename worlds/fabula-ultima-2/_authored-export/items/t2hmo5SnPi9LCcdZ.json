      "custom_logic_action": "<p>(async () =&gt; {</p><p>  const TAG = \"[CL-ACTION][GOLEM-FIST-WEIGHTED]\";</p><p>  const p = __PAYLOAD;</p><p>  if (!p) {</p><p>    console.warn(TAG, \"Missing __PAYLOAD.\");</p><p>    return;</p><p>  }</p><p>  // --------------------------------------------------</p><p>  // Resolve attacker</p><p>  // --------------------------------------------------</p><p>  const attackerUuid =</p><p>    p?.meta?.attackerUuid ??</p><p>    p?.attackerUuid ??</p><p>    \"\";</p><p>  const attackerDoc = await fromUuid(attackerUuid);</p><p>  const attackerActor = attackerDoc?.actor ?? attackerDoc;</p><p>  if (!attackerActor) {</p><p>    console.warn(TAG, \"Could not resolve attacker actor.\", { attackerUuid });</p><p>    return;</p><p>  }</p><p>  // --------------------------------------------------</p><p>  // Read attacker Defense score</p><p>  // Data key: actor.system.props.defense</p><p>  // --------------------------------------------------</p><p>  const rawDefense = foundry.utils.getProperty(</p><p>    attackerActor,</p><p>    \"system.props.defense\"</p><p>  );</p><p>  const defenseScore = Math.max(0, Number(rawDefense) || 0);</p><p>  if (defenseScore &lt;= 0) {</p><p>    console.log(TAG, \"No bonus applied. Defense score is 0 or invalid.\", {</p><p>      attacker: attackerActor.name,</p><p>      rawDefense</p><p>    });</p><p>    return;</p><p>  }</p><p>  // --------------------------------------------------</p><p>  // Add Defense as flat bonus damage</p><p>  // --------------------------------------------------</p><p>  p.advPayload = p.advPayload || {};</p><p>  const beforeBonus = Number(p.advPayload.bonus ?? 0) || 0;</p><p>  p.advPayload.bonus = beforeBonus + defenseScore;</p><p>  // Optional debug marker</p><p>  p.meta = p.meta || {};</p><p>  p.meta.golemFistWeightedBonus = {</p><p>    source: \"defense\",</p><p>    rawDefense,</p><p>    defenseScore,</p><p>    bonusBefore: beforeBonus,</p><p>    bonusAfter: p.advPayload.bonus</p><p>  };</p><p>  console.log(TAG, \"APPLIED Defense as flat bonus damage.\", {</p><p>    attacker: attackerActor.name,</p><p>    rawDefense,</p><p>    defenseScore,</p><p>    bonusBefore: beforeBonus,</p><p>    bonusAfter: p.advPayload.bonus</p><p>  });</p><p>})();</p>",
