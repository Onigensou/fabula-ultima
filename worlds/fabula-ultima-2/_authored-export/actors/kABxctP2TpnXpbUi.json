      "normal_spell_list": {
        "0": {
          "$deleted": false,
          "class": "",
          "cost": "20",
          "description": "<p><span dir=\"ltr\" role=\"presentation\">You strengthen the heart of a creature against suffering and despair. Until this spell</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">ends, if the target would be reduced to 0 Hit Points, they are instead left standing with</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">exactly 1 Hit Point. Once that happens, this spell ends.</span></p>",
          "duration": "Scene",
          "roll": "",
          "spell_name": "Mercy",
          "target": "One Creature"
        },
        "1": {
          "$deleted": false,
          "class": "",
          "cost": "20",
          "description": "<p><span dir=\"ltr\" role=\"presentation\">You bend the fabric of time. Until this spell ends, the target gains the ability to perform</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">a single additional action during each of their turns. Once the target has performed a</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">total of two additional actions granted by this spell, this spell ends</span></p>",
          "duration": "Scene",
          "roll": "",
          "spell_name": "Acceleration",
          "target": "One Creature"
        },
        "2": {
          "$deleted": false,
          "class": "",
          "cost": "10",
          "description": "<p><span dir=\"ltr\" role=\"presentation\">You twist the laws of magic. Until this spell ends, if an offensive (</span><span dir=\"ltr\" role=\"presentation\">r</span><span dir=\"ltr\" role=\"presentation\">r</span><span dir=\"ltr\" role=\"presentation\">) spell is cast</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">on the target, the creature who cast that offensive spell will be targeted in their</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">stead (any other targets of the offensive spell will be targeted as normal). Once that</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">happens, this spell ends</span></p>",
          "duration": "Scene",
          "roll": "",
          "spell_name": "Mirror",
          "target": "One Creature"
