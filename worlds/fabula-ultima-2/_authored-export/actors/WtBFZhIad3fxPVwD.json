    "props": {
      "also_text": "Adventurer, Explorer, Treasure Hunter",
      "benefit_dropdown": "ip_benefit",
      "classMechanic_text": "<h1>WAYFARER’S COMPANION</h1><p></p><h3>THE COMPANION</h3><p>Together with the rest of your group, design a <strong>level 5</strong> <em>beast, construct, elemental,</em> or <em>plant</em> creature that becomes your companion.</p><ul><li>The companion has <strong>no Initiative score</strong> and <strong>does not level up</strong>.</li><li>It can have <strong>up to two basic attacks</strong>.</li><li>It gains a bonus equal to <strong>【SL】</strong> to <strong>Accuracy Checks</strong> and <strong>Magic Checks</strong>.</li><li>Its maximum Hit Points are equal to <strong>【(SL × the companion’s base Might die size) + half your level】</strong>.</li></ul><p></p><h3>TURN AND ACTION ECONOMY</h3><p>Your companion does not receive its own turn during conflicts. <strong>On your turn, you may use an action to have the companion perform one action</strong> (only once per turn). This action is resolved by the companion using its own statistics and position on the scene, but it <strong>consumes your action</strong>.</p><p></p><h3>SCENE INTERACTIONS</h3><ul><li>If you <strong>leave a scene</strong>, your companion leaves with you.</li><li>At the <strong>start of any scene in which you are present</strong>, your companion appears with you and can be commanded as above.</li><li>When you <strong>rest</strong>, your companion also gains the full benefits of resting.</li></ul><p></p><h3>CRISIS AND RETURN</h3><p>If your companion <strong>falls to 0 Hit Points</strong>, it flees and cannot act. It <strong>rejoins you at the start of the next scene</strong> in which you are present with HP equal to its <strong>【Crisis】</strong> score.</p><p></p><h3>NOTES</h3><ul><li>The companion counts as an allied creature and is affected by effects that target allies or creatures as normal.</li><li>Only one commanding action for the companion may be issued per your turn, even if you gain additional actions from other effects.</li></ul>",
      "class_facet": {
        "2HCWunsXrIrCNX5k": {
          "facet_cost": "",
          "facet_description": "<p>When you <strong>rest</strong> inside an inn or tavern, you may ask the Game Master up to <strong>【SL】</strong> questions about your surroundings and the people who live here; the Game Master will answer truthfully and you describe how you gathered the information</p>",
          "facet_offensive": "",
          "facet_target": "",
          "id": "${item.id}",
          "name": "Tavern Talk",
          "uuid": "Actor.WtBFZhIad3fxPVwD.Item.2HCWunsXrIrCNX5k"
        },
        "2amtYSrRS83lzT7H": {
          "facet_cost": "",
          "facet_description": "<p>You reduce the die rolled for your <strong>travel rolls</strong> by one size (to a minimum of <strong>d6</strong>). If multiple characters have this Skill, the effects are <strong>not</strong> cumulative.</p>",
          "facet_offensive": "",
          "facet_target": "",
          "id": "${item.id}",
          "name": "Well-Traveled",
          "uuid": "Actor.WtBFZhIad3fxPVwD.Item.2amtYSrRS83lzT7H"
        },
        "6dBpxXmkt2WXbXIW": {
          "facet_cost": "",
          "facet_description": "<p>When you make an Accuracy Check and roll a <strong>critical success</strong>, you or another creature of your choice regains 1 Inventory Point.</p>\n",
          "facet_offensive": "",
          "facet_target": "",
          "id": "${item.id}",
          "name": "Harvester",
          "uuid": "Actor.WtBFZhIad3fxPVwD.Item.6dBpxXmkt2WXbXIW"
        },
        "PpTMiE4oSJ7XlBHI": {
          "facet_cost": "",
          "facet_description": "<p>Together with the rest of your group, design a <strong>level 5 beast, construct, elemental </strong>or<strong> plant</strong> creature that becomes your <strong>companion</strong>. This creature has <strong>no</strong> <strong>Initiative score</strong> and <strong>does not level up</strong>, can have <strong>up to two basic attacks</strong>, gains a bonus equal to <strong>【SL】</strong> to Accuracy Checks and Magic Checks, and their maximum Hit Points are equal to <strong>【(SL multiplied by the companion's base Might die size) + half your level】</strong>.</p><p>Your companion doesn't get a turn during conflicts, but on your turn you can use an action to have the companion perform an action (only once per turn). If you leave a scene, your companion leaves with you.</p><p>If your companion falls to 0 Hit Points, they flee and rejoin you at the start of the next scene in which you are present, with HP equal to their <span style=\"font-family: Signika, sans-serif\"><a class=\"content-link\" draggable=\"true\" data-link=\"\" data-uuid=\"JournalEntry.GJevbCPM8cffm1QM\" data-id=\"GJevbCPM8cffm1QM\" data-type=\"JournalEntry\" data-tooltip=\"Journal Entry\" style=\"box-sizing: border-box; user-select: text; scrollbar-width: thin; scrollbar-color: rgb(93, 20, 43) rgba(0, 0, 0, 0); cursor: pointer; --content-link-background: rgba(0, 0, 0, 0.1); background-image: none !important; background-position: initial !important; background-size: initial !important; background-repeat: initial !important; background-attachment: initial !important; background-origin: initial !important; background-clip: initial !important; background-color: rgb(102, 102, 102); padding: 0px !important; border: none !important; border-radius: 2px; white-space: nowrap; word-break: break-all; color: rgb(25, 24, 19); font-weight: bold; text-decoration: underline; display: inline-flex; align-items: center; position: relative; top: 2px; font-family: Signika, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px;\"><strong><span style=\"text-decoration: underline;\">Crisis</span></strong></a></span> score. When you rest, your companion also gains the full benefits of resting.</p>",
          "facet_offensive": "",
          "facet_target": "",
          "id": "${item.id}",
          "name": "Faithful Companion",
          "uuid": "Actor.WtBFZhIad3fxPVwD.Item.PpTMiE4oSJ7XlBHI"
        },
        "UDKkNARcCfg6NboU": {
          "facet_cost": "",
          "facet_description": "<p>When your group journeys on the world map, you will make a <strong>discovery</strong> on a roll of <strong>【SL + 1】 or lower</strong> on the <strong>travel roll</strong> <em>(instead of only on a 1).</em></p>",
          "facet_offensive": "",
          "facet_target": "",
          "id": "${item.id}",
          "name": "Treasure Hunter",
          "uuid": "Actor.WtBFZhIad3fxPVwD.Item.UDKkNARcCfg6NboU"
        },
        "UDZCCxA0SQPvKj8S": {
          "facet_cost": "",
          "facet_description": "<p>You become completely immune to a single status effect of your choice.</p>",
          "facet_offensive": "",
          "facet_target": "",
          "id": "${item.id}",
          "name": "Status Immunity",
          "uuid": "Actor.WtBFZhIad3fxPVwD.Item.UDZCCxA0SQPvKj8S"
        },
        "WJS9dyE8WMi3RRZn": {
          "facet_cost": "",
          "facet_description": "<p>You recover <strong>【SL】</strong> Inventory Points after each <strong>travel roll</strong></p>",
          "facet_offensive": "",
          "facet_target": "",
          "id": "${item.id}",
          "name": "Resourceful",
          "uuid": "Actor.WtBFZhIad3fxPVwD.Item.WJS9dyE8WMi3RRZn"
        },
        "gyzWIVEBfEieLNwh": {
          "facet_cost": "",
          "facet_description": "<div class=\"companion-upgrade\">\n  <p><strong>Your bond with your companion grows stronger.</strong><br>\n     You gain the following benefits:</p>\n\n  <ul class=\"book-bullets\">\n    <li>The companion’s maximum Hit Points increase by 10.</li>\n    <li>\n      Choose one of the companion’s Attributes:\n      <strong>Dexterity, Insight, Might</strong>, or <strong>Willpower</strong>.\n      The chosen Attribute is permanently increased by one die size\n      (up to a maximum size of <strong>d12</strong>).\n    </li>\n    <li>\n      The companion gains an additional Skill. When you reach level 40, or if you have\n      already reached it, the companion gains an additional Skill. Make sure to discuss\n      your Skill choices with the Game Master and the other Players.\n    </li>\n  </ul>\n</div>\n\n<style>\n  .companion-upgrade { font-family: var(--chat-font, \"Signika\", system-ui, sans-serif); line-height: 1.45; }\n  .book-bullets { margin: .3rem 0 0; padding-left: 1.4rem; }\n  .book-bullets li {\n    list-style: none;\n    position: relative;\n    margin: .25rem 0;\n  }\n  .book-bullets li::before {\n    content: \"◆\";\n    position: absolute;\n    left: -1.2rem;\n    top: .1rem;\n    font-weight: 800;\n    /* use current text color so it matches your theme */\n    color: currentColor;\n  }\n</style>\n",
          "facet_offensive": "",
          "facet_target": "",
          "id": "${item.id}",
          "name": "Heroic Companion",
          "uuid": "Actor.WtBFZhIad3fxPVwD.Item.gyzWIVEBfEieLNwh"
        }
      },
