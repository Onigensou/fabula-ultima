      "skill_list": {
        "0": {
          "$deleted": false,
          "class": "Pilot",
          "description": "<p>[Personal Vehicle]</p>\n<p>When you acquire this Skill, you gain a <strong>personal vehicle</strong> with a<strong> frame</strong> of your choice and <strong>three different modules</strong> of your choice.<br>Whenever you acquire this Skill again, you acquire<strong> two additional modules</strong> of your choice.</p>\n<p>You use Exoskeleton frame.</p>\n<p>You can have total of <strong>8&nbsp;</strong>enabled modules at any time.</p>\n<p>You have total of <strong>11</strong> modules:</p>\n<ol>\n<li>[Armor] Standard Plating</li>\n<li>[Weapon] Shield (Main-hand)</li>\n<li>[Weapon] Shield (Off-hand)</li>\n<li>[Weapon] Cannon</li>\n<li>[Support] Aerial</li>\n<li>[Support] Anti-Element</li>\n<li>[Support] Advanced Targeting</li>\n<li>[Support] Excavation</li>\n<li>[Support] Power</li>\n<li>[Support] Rapid Interface</li>\n<li>[Support] Secondary Offensive</li>\n</ol>",
          "level": "5",
          "roll": "",
          "skill_name": "Form of Titan"
        },
        "1": {
          "$deleted": false,
          "class": "Pilot",
          "description": "<p>Titan's combat form.</p>\n<p>Enabled Modules:</p>\n<ol>\n<li>[Armor] <strong>Standard Plating</strong></li>\n<li>[Weapon]<strong> Shield (Main-hand)</strong></li>\n<li>[Weapon] <strong>Shield (Off-hand)</strong></li>\n<li>[Support] <strong>Anti-Element</strong></li>\n<li>[Support] <strong>Advanced Targeting</strong></li>\n<li>[Support] <strong>Power</strong></li>\n<li>[Support] <strong>Rapid Interface</strong></li>\n<li>[Support] <strong>Secondary Offensive</strong></li>\n</ol>",
          "level": "1",
