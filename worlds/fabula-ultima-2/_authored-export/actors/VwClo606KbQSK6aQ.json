      "sort": 0,
      "system": {
        "props": {
          "action_keywords": "",
          "active_effect_config_table": {},
          "ae_chance_percent": "",
          "ae_template_ref": "",
          "animation_damage_timing_offset": "0",
          "animation_damage_timing_options": "default",
          "animation_script": "<p>(async () =&gt; {</p><p>  const payload = globalThis.__PAYLOAD || {};</p><p>  const CFG = {\"slideMs\":2800,\"fadeInMs\":500,\"fadeOutMs\":700,\"stopShortPx\":140,\"failsafeMs\":9000};</p><p>  const INNER = \"\\n  // ctx = { casterToken, targetTokens, params, meta }\\n  const P = ctx.params || {};\\n  const cfg = P.cfg || {};\\n  const fire = () =&gt; { try { Hooks.callAll(P.doneHook); } catch (e) {} };\\n\\n  // Hidden tab: rAF is paused, so drawing here would pile up un-painted and\\n  // burst on refocus. Drop it — but ALWAYS fire the hook or the GM waits out\\n  // the failsafe for nothing.\\n  try {\\n    if (globalThis.FUCompanion &amp;&amp; globalThis.FUCompanion.api\\n        &amp;&amp; typeof globalThis.FUCompanion.api.vfxSuppressed === 'function'\\n        &amp;&amp; globalThis.FUCompanion.api.vfxSuppressed()) { fire(); return; }\\n  } catch (e) {}\\n\\n  const caster = ctx.casterToken;\\n  const victim = (ctx.targetTokens || [])[0];\\n  if (!caster || !victim) { fire(); return; }\\n\\n  const stage = canvas.stage;\\n  stage.sortableChildren = true;\\n  const layer = new PIXI.Container();\\n  layer.zIndex = 480;          // above tiles/tokens, below the whiteout band\\n  layer.alpha = 0;\\n  stage.addChild(layer);\\n\\n  const DARK = 0x2b1b3d, GLOW = 0x9a6fd4;\\n\\n  // The tether. Redrawn every frame because the caster is physically moving.\\n  const tether = new PIXI.Graphics();\\n  layer.addChild(tether);\\n\\n  // A chevron over the victim plus their name, so the target is unambiguous.\\n  const marker = new PIXI.Container();\\n  const chev = new PIXI.Graphics();\\n  chev.beginFill(GLOW, 0.95);\\n  chev.moveTo(-16, -14); chev.lineTo(16, -14); chev.lineTo(0, 8); chev.closePath();\\n  chev.endFill();\\n  marker.addChild(chev);\\n  const label = new PIXI.Text(String(victim.document.name || ''), {\\n    fontFamily: 'Signika, sans-serif', fontSize: 22, fill: 0xe8dcff,\\n    stroke: 0x150a22, strokeThickness: 5,\\n  });\\n  label.anchor.set(0.5, 1);\\n  label.position.set(0, -20);\\n  marker.addChild(label);\\n  layer.addChild(marker);\\n\\n  const t0 = performance.now();\\n  const total = (cfg.fadeInMs || 400) + (cfg.slideMs || 2400) + (cfg.fadeOutMs || 600);\\n  let done = false;\\n\\n  const tick = () =&gt; {\\n    const e = performance.now() - t0;\\n\\n    // envelope\\n    let a = 1;\\n    if (e &lt; cfg.fadeInMs) a = e / cfg.fadeInMs;\\n    else if (e &gt; total - cfg.fadeOutMs) a = Math.max(0, (total - e) / cfg.fadeOutMs);\\n    layer.alpha = a;\\n\\n    const c = caster.center, v = victim.center;\\n\\n    // tether: a dark cord with a travelling highlight\\n    tether.clear();\\n    tether.lineStyle(6, DARK, 0.55 * a);\\n    tether.moveTo(c.x, c.y); tether.lineTo(v.x, v.y);\\n    tether.lineStyle(2, GLOW, 0.85 * a);\\n    tether.moveTo(c.x, c.y); tether.lineTo(v.x, v.y);\\n\\n    // a bead crawling along the cord, so the direction of travel is legible\\n    const k = (e % 1600) / 1600;\\n    tether.beginFill(GLOW, 0.9 * a);\\n    tether.drawCircle(c.x + (v.x - c.x) * k, c.y + (v.y - c.y) * k, 5);\\n    tether.endFill();\\n\\n    // chevron bobs above the victim\\n    const bob = Math.sin(e / 380) * 6;\\n    marker.position.set(v.x, v.y - (victim.h * 0.5) - 34 + bob);\\n\\n    if (e &gt;= total &amp;&amp; !done) {\\n      done = true;\\n      canvas.app.ticker.remove(tick);\\n      try { layer.destroy({ children: true }); } catch (err) {}\\n      fire();\\n    }\\n  };\\n  canvas.app.ticker.add(tick);\\n\\n  // Failsafe: a stalled ticker must not strand the GM.\\n  setTimeout(() =&gt; {\\n    if (done) return;\\n    done = true;\\n    try { canvas.app.ticker.remove(tick); } catch (e) {}\\n    try { layer.destroy({ children: true }); } catch (e) {}\\n    fire();\\n  }, total + 1500);\\n\";</p><p></p><p>  const doneHook = \"roo-approach-\" + foundry.utils.randomID();</p><p>  const onceHook = (h, ms) =&gt; new Promise((res) =&gt; {</p><p>    let fired = false;</p><p>    const id = Hooks.once(h, () =&gt; { if (!fired) { fired = true; res(true); } });</p><p>    setTimeout(() =&gt; { if (!fired) { fired = true; try { Hooks.off(h, id); } catch (e) {} res(false); } }, ms);</p><p>  });</p><p></p><p>  // Caster: the Roo. Targets: the marked creature (the ap_target row resolves</p><p>  // to exactly the one carrying \"Marked\").</p><p>  const casterUuid = payload.casterTokenUuid</p><p>    || (canvas.tokens.controlled[0] &amp;&amp; canvas.tokens.controlled[0].document.uuid);</p><p>  const casterTok = canvas.tokens.placeables.find((t) =&gt; t.document.uuid === casterUuid);</p><p>  const victimTok = Array.from(game.user.targets)[0]</p><p>    || canvas.tokens.placeables.find((t) =&gt; (payload.targetTokenUuids || []).includes(t.document.uuid));</p><p></p><p>  if (!casterTok || !victimTok) return;</p><p></p><p>  Hooks.callAll(\"oni:animationStart\", { skill: \"Approach\" }, { local: true, world: false });</p><p>  try {</p><p>    // How far along the walk are we? The Approach AE has already ticked by the</p><p>    // time this runs, so charges is 1, 2 or 3.</p><p>    let charges = 1;</p><p>    try {</p><p>      const ae = casterTok.actor.effects.find((e) =&gt; !e.disabled &amp;&amp; String(e.name).toLowerCase() === \"approach\");</p><p>      charges = Math.max(1, Math.min(3, Number(ae?.flags?.[\"fabula-ultima-companion\"]?.charges ?? 1) || 1));</p><p>    } catch (e) {}</p><p></p><p>    // Stateless and self-correcting: travel 1/(4-charges) of what is LEFT, so</p><p>    // 1/3 then 1/2 then all of it. If the victim moved, the geometry simply</p><p>    // re-converges next turn; no stored home position to go stale.</p><p>    const c = casterTok.center, v = victimTok.center;</p><p>    const dx = v.x - c.x, dy = v.y - c.y;</p><p>    const dist = Math.hypot(dx, dy) || 1;</p><p>    const reach = Math.max(0, dist - CFG.stopShortPx);</p><p>    const travel = reach / (4 - charges);</p><p>    const nx = c.x + (dx / dist) * travel - (casterTok.w / 2);</p><p>    const ny = c.y + (dy / dist) * travel - (casterTok.h / 2);</p><p></p><p>    // Foundry replicates token movement to every client on its own, so the</p><p>    // slide needs no broadcast — only the tether does.</p><p>    const move = casterTok.document.update(</p><p>      { x: Math.round(nx), y: Math.round(ny) },</p><p>      { animation: { duration: CFG.slideMs, easing: \"easeInOutCosine\" } }</p><p>    );</p><p></p><p>    // scriptId is REQUIRED even in scriptSource mode: validateOutgoing rejects</p><p>    // a payload without one and the emit is dropped with only a console warn,</p><p>    // so the token would still slide but the tether would never draw. It is</p><p>    // just a dedupe/logging label here; the listener runs scriptSource.</p><p>    const vfx = game.ONI.pseudo.play({</p><p>      scriptId: \"roo-approach\",</p><p>      scriptSource: INNER,</p><p>      casterTokenUuid: casterTok.document.uuid,</p><p>      targetTokenUuids: [victimTok.document.uuid],</p><p>      params: { doneHook, cfg: CFG },</p><p>    });</p><p></p><p>    await Promise.all([move, vfx, onceHook(doneHook, CFG.failsafeMs)]);</p><p>  } catch (e) {</p><p>    console.error(\"Roo Approach animation:\", e);</p><p>  } finally {</p><p>    Hooks.callAll(\"oni:animationEnd\", { skill: \"Approach\" }, { local: true, world: false });</p><p>  }</p><p>})();</p>",
          "check_bonus": "0",
          "class": "NPC",
