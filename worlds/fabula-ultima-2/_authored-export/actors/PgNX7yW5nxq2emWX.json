        "4IrUKGEoVA4r7gls": {
          "active_cost": "-",
          "active_description": "<p>Cheeks full, the Gorger turns to leave. The party makes a <strong>DL 15</strong> <strong>【DEX + INS】</strong> Group Check — on a failure it slips away and the conflict carries on without it.</p>",
          "active_duration": "Instantaneous",
          "active_target": "Self",
          "id": "${item.id}",
          "name": "Run Away",
          "roll": "",
          "uuid": "Actor.PgNX7yW5nxq2emWX.Item.4IrUKGEoVA4r7gls"
        },
        "VhNtcDifD3ptNgOE": {
          "active_cost": "-",
          "active_description": "<p>The Gorger latches on and drinks. Whatever magic the target was holding is simply gone — their <strong>MP is reduced to 0</strong>.</p>",
          "active_duration": "Instantaneous",
          "active_target": "One Creature",
          "id": "${item.id}",
          "name": "Consume Mana",
          "roll": "",
