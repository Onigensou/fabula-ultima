          "cost": "10(5)",
          "description": "<p>Choose one ally you can see who has yet to take a turn during this round.</p>\n<p>&nbsp;</p>\n<p>That ally maytake their turn immediately after yours during this round.</p>",
          "duration": "Instantaneous",
          "roll": "",
