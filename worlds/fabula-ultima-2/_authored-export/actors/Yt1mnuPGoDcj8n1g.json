        "5": {
          "$deleted": false,
          "class": "Rogue",
          "cost": "0",
          "description": "<p>When you hit a creature with an attack, if the attack only targeted that creature and<br>they are suffering from one or more status effects, you may have it deal extra damage<br>equal to 【4 + the number of status effects on the creature】】. This extra damage is&nbsp;<br>doubled if the attack's High Roll was not equal to 0</p>",
          "duration": "",
          "roll": "",
          "spell_name": "Cheap Shot",
          "target": ""
