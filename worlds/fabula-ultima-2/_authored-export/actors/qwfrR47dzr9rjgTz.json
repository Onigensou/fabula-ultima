      "skill_hp": "0",
      "skill_ip": "",
      "skill_list": {
        "0": {
          "$deleted": false,
          "class": "Rogue",
          "description": "<p><span class=\"fontstyle0\">When you hit a creature with an attack, if the attack </span><span class=\"fontstyle2\">only </span><span class=\"fontstyle0\">targeted that creature and they are suffering from </span><span class=\"fontstyle2\">one or more status effects</span><span class=\"fontstyle0\">, you may have it deal extra damage<br>equal to</span><span class=\"fontstyle3\">【</span><span class=\"fontstyle2\">5 + (the number of status effects on that creature, multiplied by two if your attack's High Roll is not equal to 0)</span><span class=\"fontstyle3\">】</span><br style=\" font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; line-height: normal; orphans: 2; text-align: -webkit-auto; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-size-adjust: auto; -webkit-text-stroke-width: 0px; \"></p>",
          "level": "5",
          "roll": "",
          "skill_name": "CHEAP SHOT"
        },
        "1": {
          "$deleted": false,
          "class": "Rogue",
          "description": "<p><span class=\"fontstyle0\">As long as you have no </span><span class=\"fontstyle2\">shields </span><span class=\"fontstyle0\">and no </span><span class=\"fontstyle2\">martial armor </span><span class=\"fontstyle0\">equipped, your Defense score is increased by</span><span class=\"fontstyle3\">【</span><span class=\"fontstyle2\">3</span><span class=\"fontstyle3\">】</span><span class=\"fontstyle0\">.</span> <br style=\" font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; line-height: normal; orphans: 2; text-align: -webkit-auto; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-size-adjust: auto; -webkit-text-stroke-width: 0px; \"></p>",
          "level": "3",
          "roll": "",
          "skill_name": "DODGE"
        },
        "2": {
          "$deleted": false,
          "class": "Rogue",
          "description": "<p><span class=\"fontstyle0\">You may use an action and spend 1 Fabula Point to vanish from the current scene, reappearing whenever you want during a </span><span class=\"fontstyle2\">different </span><span class=\"fontstyle0\">scene in which another Player<br>Character is present. Describe how you escaped and miraculously got here!</span> <br style=\" font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; line-height: normal; orphans: 2; text-align: -webkit-auto; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-size-adjust: auto; -webkit-text-stroke-width: 0px; \"></p>",
          "level": "1",
          "roll": "",
          "skill_name": "SEE YOU LATER"
        },
        "3": {
          "$deleted": false,
          "class": "Rogue",
          "description": "<p><span class=\"fontstyle0\">You may use an action to perform a</span><span class=\"fontstyle2\">【</span><span class=\"fontstyle3\">DEX + WLP</span><span class=\"fontstyle2\">】 </span><span class=\"fontstyle0\">Check against the Magic Defense of a creature you can see. If you succeed and the target is a </span><span class=\"fontstyle3\">soldier</span><span class=\"fontstyle0\">, you recover</span><span class=\"fontstyle2\">【</span><span class=\"fontstyle3\">SL</span><span class=\"fontstyle2\">】</span><span class=\"fontstyle0\">Inventory Points; if they are an </span><span class=\"fontstyle3\">elite </span><span class=\"fontstyle0\">or </span><span class=\"fontstyle3\">champion</span><span class=\"fontstyle0\">, the GM gives you the target’s </span><span class=\"fontstyle3\">soul treasure</span><span class=\"fontstyle0\">, an item worth an amount of zenit </span><span class=\"fontstyle3\">equal to or lower than</span><span class=\"fontstyle2\">【</span><span class=\"fontstyle3\">the target's level multiplied by 30, or by 50 if they are a Villain</span><span class=\"fontstyle2\">】</span><span class=\"fontstyle0\">This </span><span class=\"fontstyle3\">soul treasure </span><span class=\"fontstyle0\">will appear inside your </span><span class=\"fontstyle3\">backpack</span><span class=\"fontstyle0\">; a creature can be successfully stolen from with this Skill only once.<br>You gain a bonus equal to</span><span class=\"fontstyle2\">【</span><span class=\"fontstyle3\">SL</span><span class=\"fontstyle2\">】 </span><span class=\"fontstyle0\">to your</span><span class=\"fontstyle2\">【</span><span class=\"fontstyle3\">DEX + WLP</span><span class=\"fontstyle2\">】 </span><span class=\"fontstyle0\">Checks for this Skill</span> <br style=\" font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; line-height: normal; orphans: 2; text-align: -webkit-auto; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-size-adjust: auto; -webkit-text-stroke-width: 0px; \"></p>",
          "level": "1",
          "roll": "",
          "skill_name": "SOUL STEAL"
        },
        "4": {
          "$deleted": false,
          "class": "Dancer",
          "description": "<p><span class=\"fontstyle0\">hoose another creature that is able to see you. If that creature is already </span><span class=\"fontstyle2\">dazed</span><span class=\"fontstyle0\">, they immediately suffer </span><span class=\"fontstyle2\">slow</span><span class=\"fontstyle0\">.</span> <br style=\" font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; line-height: normal; orphans: 2; text-align: -webkit-auto; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-size-adjust: auto; -webkit-text-stroke-width: 0px; \"></p>",
          "level": "1",
          "roll": "",
          "skill_name": "Kraken Dance"
        },
        "5": {
          "$deleted": false,
          "class": "Dancer",
          "description": "<p><span class=\"fontstyle0\">Choose another creature that is able to see you. If that creature is already </span><span class=\"fontstyle2\">slow</span><span class=\"fontstyle0\">, they immediately suffer </span><span class=\"fontstyle2\">shaken</span> <br style=\" font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; line-height: normal; orphans: 2; text-align: -webkit-auto; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-size-adjust: auto; -webkit-text-stroke-width: 0px; \"></p>",
          "level": "1",
          "roll": "",
          "skill_name": "Banshee Dance"
        },
        "6": {
          "$deleted": false,
          "class": "Dancer",
          "description": "<p><span class=\"fontstyle0\">After you perform a </span><span class=\"fontstyle2\">dance</span><span class=\"fontstyle0\">, your attacks with </span><span class=\"fontstyle2\">brawling</span><span class=\"fontstyle0\">, </span><span class=\"fontstyle2\">dagger</span><span class=\"fontstyle0\">, </span><span class=\"fontstyle2\">flail </span><span class=\"fontstyle0\">and </span><span class=\"fontstyle2\">thrown </span><span class=\"fontstyle0\">weapons deal</span><span class=\"fontstyle3\">【</span><span class=\"fontstyle2\">5</span><span class=\"fontstyle3\">】 </span><span class=\"fontstyle0\">extra damage until the start of your next turn. </span></p><p><span class=\"fontstyle0\">If you have an </span><span class=\"fontstyle2\">arcane </span><span class=\"fontstyle0\">weapon equipped, offensive spells (</span><span class=\"fontstyle4\">r</span><span class=\"fontstyle0\">) you cast also deal</span><span class=\"fontstyle3\">【</span><span class=\"fontstyle2\">SL</span><span class=\"fontstyle3\">】 </span><span class=\"fontstyle0\">extra damage<br>until the start of your next turn</span> <br style=\" font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; line-height: normal; orphans: 2; text-align: -webkit-auto; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-size-adjust: auto; -webkit-text-stroke-width: 0px; \"></p>",
          "level": "5",
          "roll": "",
          "skill_name": "WARDANCER"
        },
        "7": {
          "$deleted": false,
          "class": "Dancer",
          "description": "<p><span class=\"fontstyle0\">After you perform a </span><span class=\"fontstyle2\">dance</span><span class=\"fontstyle0\">, you may perform the </span><span class=\"fontstyle2\">Equipment </span><span class=\"fontstyle0\">action for free</span> <br style=\" font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; line-height: normal; orphans: 2; text-align: -webkit-auto; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-size-adjust: auto; -webkit-text-stroke-width: 0px; \"></p>",
          "level": "1",
          "roll": "",
          "skill_name": "QUICK-CHANGE"
        },
        "8": {
          "$deleted": false,
          "class": "Dancer",
          "description": "<p><span class=\"fontstyle0\">After you perform a </span><span class=\"fontstyle2\">dance </span><span class=\"fontstyle0\">with a </span><span class=\"fontstyle2\">duration </span><span class=\"fontstyle0\">of “Until the start of your next turn”, you gain bonus equal to</span><span class=\"fontstyle3\">【</span><span class=\"fontstyle2\">SL × 2</span><span class=\"fontstyle3\">】 </span><span class=\"fontstyle0\">to all Opposed Checks that rely on </span><span class=\"fontstyle2\"><strong>acrobatics</strong></span><span class=\"fontstyle0\"><strong>, </strong></span><span class=\"fontstyle2\"><strong>coordination </strong></span><span class=\"fontstyle0\"><strong>or </strong></span><span class=\"fontstyle2\"><strong>speed</strong> </span><span class=\"fontstyle0\">until the start of your next turn.</span> <br style=\" font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; line-height: normal; orphans: 2; text-align: -webkit-auto; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-size-adjust: auto; -webkit-text-stroke-width: 0px; \"></p>",
          "level": "2",
          "roll": "",
          "skill_name": "FRENETIC FOOTWORK"
        },
        "9": {
          "$deleted": false,
          "class": "Slayer",
          "description": "<p>Each time you take this Skill, choose a creature <strong>Species</strong>. You may use an <strong>action</strong> and <strong>spend 2 Inventory Points</strong> to apply a bane oil for one of your chosen Species to a weapon equipped by you or a willing creature. </p><p>If you have the weapon equipped, you may perform a <strong>free attack</strong> with it as part of the same action.</p><p>Until the end of the scene or a different bane oil is applied to the weapon, when a creature of the same Species as the bane oil is hit by the weapon, that creature <strong>loses one of its damage Resistances</strong> and suffer <strong>weak</strong>. </p><p>If you know the creature’s Affinities,</p><p>you may choose the damage type; otherwise, the GM chooses one at random.</p>",
          "level": "1",
          "roll": "",
          "skill_name": "BANE OILS [HUMANOID]"
        },
        "10": {
          "$deleted": false,
          "class": "Slayer",
          "description": "<p>When you hit a non-soldier creature with an attack that deals damage, you deal extra damage equal to 【2 × the number of soldiers the creature replaces】.</p>",
          "level": "1",
          "roll": "",
          "skill_name": "GIANT KILLER"
        },
        "11": {
          "$deleted": false,
          "class": "Slayer",
          "description": "<p>When you hit a creature with an attack you may spend <strong>10 Mind Points</strong> and choose one of the target’s <strong>basic attacks</strong> or <strong>spells</strong>. Until the start of your next turn, the target deals</p><p>【SL × 2】 less damage with the chosen action.</p>",
          "level": "4",
          "roll": "",
          "skill_name": "LOCKDOWN"
        },
        "12": {
          "$deleted": false,
          "class": "Slayer",
          "description": "<p>When you make an <strong>Accuracy Check, Magic Check, or contested Check</strong>, you may spend <strong>1 Fabula Point</strong> and invoke one of the target’s Traits to add 【SL】 to your result against that target. </p><p>A Villain may spend 2 Ultima Points to cancel out this effect. If the Check includes multiple targets, your result against those other targets is unchanged.</p>",
          "level": "4",
          "roll": "",
          "skill_name": "EXPLOIT"
        },
        "13": {
          "$deleted": false,
          "class": "Weapon Master",
          "description": "<p><span class=\"fontstyle0\">When you hit one or more targets with a </span><span class=\"fontstyle2\">melee </span><span class=\"fontstyle0\">attack that would deal damage, you may have the attack deal no damage. </span></p><p><span class=\"fontstyle0\">If you do, choose one option: inflict </span><span class=\"fontstyle2\"><strong>dazed</strong> or</span><span class=\"fontstyle0\"> </span><span class=\"fontstyle2\"><strong>weak</strong> </span><span class=\"fontstyle0\">on each target hit by the attack; </span><span class=\"fontstyle2\">or </span><span class=\"fontstyle0\">each target hit by the attack loses</span><span class=\"fontstyle3\">【</span><span class=\"fontstyle2\">SL × 10</span><span class=\"fontstyle3\">】 </span><span class=\"fontstyle0\">Mind Points.</span></p>",
          "level": "1",
          "roll": "",
          "skill_name": "BONE CRUSHER"
        },
        "14": {
          "$deleted": false,
          "class": "Weapon Master",
          "description": "<p><span class=\"fontstyle0\">You gain a bonus equal to</span><span class=\"fontstyle2\">【</span><span class=\"fontstyle3\">SL</span><span class=\"fontstyle2\">】 </span><span class=\"fontstyle0\">to all Accuracy Checks with </span><span class=\"fontstyle3\">melee </span><span class=\"fontstyle0\">weapons.</span> <br style=\" font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; line-height: normal; orphans: 2; text-align: -webkit-auto; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-size-adjust: auto; -webkit-text-stroke-width: 0px; \"></p>",
          "level": "4",
          "roll": "",
          "skill_name": "MELEE WEAPON MASTERY"
        },
        "15": {
          "$deleted": false,
          "class": "Lore Master",
          "description": "<p><span class=\"fontstyle0\">When you perform an Accuracy Check, you may replace </span><span class=\"fontstyle2\">one </span><span class=\"fontstyle0\">of the Attribute dice with </span><span class=\"fontstyle2\">Insight </span><span class=\"fontstyle0\">(such as</span><span class=\"fontstyle3\">【</span><span class=\"fontstyle2\">INS + INS</span><span class=\"fontstyle3\">】 </span><span class=\"fontstyle0\">for a </span><span class=\"fontstyle2\">pistol </span><span class=\"fontstyle0\">or</span><span class=\"fontstyle3\">【</span><span class=\"fontstyle2\">INS + MIG</span><span class=\"fontstyle3\">】 </span><span class=\"fontstyle0\">for a </span><span class=\"fontstyle2\">waraxe</span><span class=\"fontstyle0\">).</span> <br style=\" font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; line-height: normal; orphans: 2; text-align: -webkit-auto; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-size-adjust: auto; -webkit-text-stroke-width: 0px; \"></p>",
          "level": "1",
          "roll": "",
          "skill_name": "KNOWLEDGE IS POWER"
        },
        "16": {
          "$deleted": false,
          "class": "Hunter",
          "description": "<p><span class=\"fontstyle0\">You may spend 10 MP to track prey that is not currently in the scene and whose leads can be followed through conventional, hunter-related means.</span></p><p><span class=\"fontstyle0\"><br>The target must perform an Opposed </span><span class=\"fontstyle2\">【</span><span class=\"fontstyle3\">WLP + INS</span><span class=\"fontstyle2\">】<br></span><span class=\"fontstyle0\">Check against you, and you gain a bonus equal to </span><span class=\"fontstyle2\">【</span><span class=\"fontstyle3\">SL</span><span class=\"fontstyle2\">】 </span><span class=\"fontstyle0\">on this Check.<br></span></p><p><span class=\"fontstyle0\">If the tracking is successful, you arrive at the prey’s location. If a conflict begins, your first Accuracy Check gains a bonus of </span><span class=\"fontstyle2\">【</span><span class=\"fontstyle3\">SL</span><span class=\"fontstyle2\">】 </span><span class=\"fontstyle0\">against the prey. </span></p><p><span class=\"fontstyle0\">If successful, it deals an additional </span><span class=\"fontstyle2\">【</span><span class=\"fontstyle3\">HR + 15</span><span class=\"fontstyle2\">】</span><span class=\"fontstyle0\">damage.<br>This ability ends if you are reduced to 0 HP, attack the prey, choose to track another target, or by Game Master ruling.</span> <br style=\" font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; line-height: normal; orphans: 2; text-align: -webkit-auto; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-size-adjust: auto; -webkit-text-stroke-width: 0px; \"></p>",
          "level": "1",
          "roll": "",
          "skill_name": "TRACK"
        }
      },
