      "normal_spell_list": {
        "0": {
          "$deleted": false,
          "class": "",
          "cost": "10",
          "description": "<p><span dir=\"ltr\" role=\"presentation\">You invigorate your companions, soothing their pain and healing their fatigue. Each</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">target recovers 40 Hit Points. This amount increases to 50 Hit Points if you are</span> <span dir=\"ltr\" role=\"presentation\">level</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">20 or higher</span><span dir=\"ltr\" role=\"presentation\">, or to 60 Hit Points if you are</span> <span dir=\"ltr\" role=\"presentation\">level 40 or higher</span><span dir=\"ltr\" role=\"presentation\">.</span></p>",
          "duration": "Instantaneous",
          "roll": "",
          "spell_name": "Heal",
          "target": "Up to three creatures"
        },
        "1": {
          "$deleted": false,
          "class": "",
          "cost": "5",
          "description": "<p><span dir=\"ltr\" role=\"presentation\">You strengthen and purify the soul energy coursing through your companions. Each</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">target recovers from all status effects.</span></p>",
          "duration": "Instantaneous",
          "roll": "",
          "spell_name": "Cleanse ",
          "target": "Up to three creatures"
        }
      },
