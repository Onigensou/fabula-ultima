      "skill_hp": "10",
      "skill_list": {
        "0": {
          "$deleted": false,
          "class": "Wayfarer",
          "description": "<p><span dir=\"ltr\" role=\"presentation\">You reduce the die rolled for your</span> <span dir=\"ltr\" role=\"presentation\">travel rolls</span> <span dir=\"ltr\" role=\"presentation\">by one size (to a minimum of</span> <span dir=\"ltr\" role=\"presentation\">d6</span><span dir=\"ltr\" role=\"presentation\">).</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">If multiple characters have this Skill, the effects are</span> <span dir=\"ltr\" role=\"presentation\">not</span> <span dir=\"ltr\" role=\"presentation\">cumulative.</span></p>",
          "level": "1",
          "roll": "",
          "skill_name": "WELL-TRAVELE"
        },
        "1": {
          "$deleted": false,
          "class": "",
          "description": "<p><span dir=\"ltr\" role=\"presentation\">Choose one option:</span><span class=\"markedContent\"><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">w</span></span> <span dir=\"ltr\" role=\"presentation\">Your NPC learns one spell and increases their maximum Mind Points by 10.</span><span class=\"markedContent\"><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">w</span></span> <span dir=\"ltr\" role=\"presentation\">Your NPC learns two spells.</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">NPCs may learn spells from Classes or from the list of</span> <span dir=\"ltr\" role=\"presentation\">NPC Spells</span> <span dir=\"ltr\" role=\"presentation\">on the next page.</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">Offensive (</span><span dir=\"ltr\" role=\"presentation\">r</span><span dir=\"ltr\" role=\"presentation\">r</span><span dir=\"ltr\" role=\"presentation\">) spells cast by NPCs may use</span><span dir=\"ltr\" role=\"presentation\">【</span><span dir=\"ltr\" role=\"presentation\">MIG + WLP</span><span dir=\"ltr\" role=\"presentation\">】</span><span dir=\"ltr\" role=\"presentation\">or</span><span dir=\"ltr\" role=\"presentation\">【</span><span dir=\"ltr\" role=\"presentation\">INS + WLP</span><span dir=\"ltr\" role=\"presentation\">】</span><span dir=\"ltr\" role=\"presentation\">for the</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">Magic Check.</span></p>",
          "level": "1",
          "roll": "",
          "skill_name": "SPELLCASTER"
        },
        "2": {
          "$deleted": false,
          "class": "",
          "description": "<p><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">Your NPC's maximum Hit Points are increased by 10.</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">This Skill is excellent for creatures that need to compensate for low defenses or</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">damage Vulnerabilities.</span></p>",
          "level": "1",
          "roll": "",
          "skill_name": "IMPROVED HIT POINTS"
        },
        "3": {
          "$deleted": false,
          "class": "Loremasters",
          "description": "<p><span dir=\"ltr\" role=\"presentation\">At the start of a conflict, you may spend up to</span><span dir=\"ltr\" role=\"presentation\">【</span><span dir=\"ltr\" role=\"presentation\">SL &times; 5</span><span dir=\"ltr\" role=\"presentation\">】</span><span dir=\"ltr\" role=\"presentation\">Mind Points. For every 5 Mind</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">Points you spend this way, choose one option: choose a creature you can see and the</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">GM reveals one of their</span> <span dir=\"ltr\" role=\"presentation\">Traits</span><span dir=\"ltr\" role=\"presentation\">;</span> <span dir=\"ltr\" role=\"presentation\">or</span> <span dir=\"ltr\" role=\"presentation\">name a damage type and choose a creature you can</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">see, and the GM reveals that creature's</span> <span dir=\"ltr\" role=\"presentation\">Affinity</span> <span dir=\"ltr\" role=\"presentation\">towards that damage type</span></p>",
          "level": "1",
          "roll": "",
          "skill_name": "QUICK ASSESSMENT "
        }
      },
