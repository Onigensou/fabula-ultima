          "cost": "10 x T MP",
          "duration": "Instantaneous",
          "id": "${item.id}",
          "name": "Ventus",
          "roll": "",
          "spell_description": "<p>The Gorger belches a gout of <a class=\"content-link\" data-uuid=\"Item.imkMQLnCLaFbaS6Y\" data-id=\"imkMQLnCLaFbaS6Y\" data-type=\"Item\" data-tooltip=\"Item\"><strong>Air</strong></a>&nbsp;at up to three creatures.</p>",
