          "passive_description": "<p>Choose a single spell among those you know. Once before the next rest, the target may perform the <strong>Spell </strong>action to cast the spell you chose (they must still pay its MP cost and perform any Magic Checks as needed)</p>",
          "passive_name": "Magic Lesson",
          "passive_roll": "",
          "passive_source": "camp activity"
        }
