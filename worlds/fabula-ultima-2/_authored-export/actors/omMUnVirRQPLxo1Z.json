        "1": {
          "$deleted": false,
          "class": "SPIRITIST",
          "cost": "5 per target up to 3",
          "description": "<p><span class=\"fontstyle0\">Until this spell ends, each target may treat their Defense as being<br>equal to 12 against any effects that target it </span></p>\n<p><span class=\"fontstyle0\">(they are still free to use their normal Defense score if higher than 12).</span> </p>",
