      "skill_list": {
        "0": {
          "$deleted": false,
          "class": "TINKERER",
          "description": "<p><span class=\"fontstyle0\">You may perform the </span><span class=\"fontstyle2\">Inventory </span><span class=\"fontstyle0\">action and spend [3 Inventory Points] to create a </span><span class=\"fontstyle2\">firearm </span><span class=\"fontstyle0\">weapon known as a </span><span class=\"fontstyle2\">magicannon</span><span class=\"fontstyle0\">. </span></p>\n<p><span class=\"fontstyle0\">The magicannon will crumble to pieces as soon as you use create a new magicannon. </span></p>\n<p><span class=\"fontstyle0\">When you create a magicannon, choose the type of damage it deals</span></p>\n<p><span class=\"fontstyle0\"> (</span><span class=\"fontstyle2\">air</span><span class=\"fontstyle0\">, </span><span class=\"fontstyle2\">bolt</span><span class=\"fontstyle0\">, </span><span class=\"fontstyle2\">earth</span><span class=\"fontstyle0\">, </span><span class=\"fontstyle2\">fire</span><span class=\"fontstyle0\">, </span><span class=\"fontstyle2\">ice</span><span class=\"fontstyle0\">, or </span><span class=\"fontstyle2\">physical</span><span class=\"fontstyle0\">).</span></p>",
          "level": "1",
          "roll": "",
          "skill_name": "GADGETS [MAGITECH] Magic Cannon"
        },
        "1": {
          "$deleted": false,
          "class": "TINKERER",
          "description": "<p><span class=\"fontstyle0\">You may use an action and spend [10 Mind Points] to perform an Opposed</span></p>\n<p><span class=\"fontstyle2\">【</span><span class=\"fontstyle3\">INS + INS</span><span class=\"fontstyle2\">】</span><span class=\"fontstyle0\">Check against a nearby normal enemy type</span><span class=\"fontstyle0\"> [</span><span class=\"fontstyle3\">construct] </span><span class=\"fontstyle0\">you can see (the Game Master must tell you who is a valid target).</span></p>\n<p><span class=\"fontstyle0\"> If you succeed, you gain control of the creature until the end of the scene (the Game Master gives you its profile).</span></p>\n<p><span class=\"fontstyle0\"> You may only control one </span><span class=\"fontstyle3\">construct </span><span class=\"fontstyle0\">at any given time, but may set it free whenever you want; the </span><span class=\"fontstyle3\">construct </span><span class=\"fontstyle0\">is also set free as soon as it is harmed by you or by one of your allies. </span></p>\n<p><span class=\"fontstyle0\">Once free, the </span><span class=\"fontstyle3\">construct </span><span class=\"fontstyle0\">is again in control of its actions and might turn against you.</span> </p>",
          "level": "1",
          "roll": "",
          "skill_name": "GADGETS [MAGITECH] OVERRIDE"
        },
        "2": {
          "$deleted": false,
          "class": "SHARPSHOOTER",
          "description": "<p><span class=\"fontstyle0\">You gain a bonus equal to</span><span class=\"fontstyle2\">【</span><span class=\"fontstyle3\">SL</span><span class=\"fontstyle2\">】 </span><span class=\"fontstyle0\">to all Accuracy Checks with </span><span class=\"fontstyle3\">ranged </span><span class=\"fontstyle0\">weapons</span> </p>",
          "level": "4",
          "roll": "",
          "skill_name": "RANGED WEAPON MASTERY"
        },
        "3": {
          "$deleted": false,
          "class": "TINKERER",
          "description": "<p><span class=\"fontstyle0\">When you create a </span><span class=\"fontstyle2\">potion </span><span class=\"fontstyle0\">that restores a </span><span class=\"fontstyle2\">single </span><span class=\"fontstyle0\">creature's HP and/or MP, you may have it affect up to</span><span class=\"fontstyle3\">【2</span><span class=\"fontstyle3\">】 </span><span class=\"fontstyle0\">additional creatures. If you do, the potion only restores half the normal amount of HP and MP to each creature.</span> </p>",
          "level": "2",
          "roll": "",
          "skill_name": "POTION RAIN "
        },
        "4": {
          "$deleted": false,
          "class": "SPIRITIST",
          "description": "<p>You learn 2 Spiritist spell</p>",
          "level": "2",
          "roll": "",
