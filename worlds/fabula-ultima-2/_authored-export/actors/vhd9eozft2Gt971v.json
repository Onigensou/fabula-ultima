      "other_list": {
        "0": {
          "$deleted": false,
          "details": "<p>All of <strong>Spica</strong>'s attacks becomes @UUID[JournalEntry.NUaxIAIPUu5Qnk8l]{Overflow}.</p><p>Each attack performs by <strong>Spica </strong>reduces her <strong>Zero Power </strong>clock by 2 sections.</p><p>Once her <strong>Zero Power </strong>clock is empty, this state ends.</p>",
          "icon": "",
          "other_name": "💥【Zero Power】 Heat RADIATION",
          "roll": ""
        },
        "1": {
          "$deleted": false,
          "details": "<p><strong>Spica </strong>perform a <strong>【spell】 </strong>action and select a creature with at least <strong>3</strong> <strong>Superheat </strong>stacks, dealing <strong>【10 x Superheat stacks】 Ice </strong>damage and inflicts @UUID[JournalEntry.0RscV9vkJNM9dVKQ]{Delay} to them.</p><p>After that, <strong>Spica </strong>may perform ⚡️<strong>Heat BOMB </strong>for free, spending required <strong>Mind Points</strong> to other creatures.</p>",
          "icon": "",
          "other_name": "💥Heat EXTRACTION",
          "roll": ""
        },
        "2": {
          "$deleted": false,
          "details": "<p><strong>Spica </strong>may remove <strong>up to</strong> <strong>3 Superheat stacks</strong> from herself.<strong> </strong>She may then removes equal amount of <strong>debuff</strong> from herself.</p>",
          "icon": "",
          "other_name": "💥 Heat CLEANSING",
          "roll": ""
        }
