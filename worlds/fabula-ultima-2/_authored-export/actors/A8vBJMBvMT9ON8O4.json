      "system": {
        "props": {
          "cost": "",
          "description": "<p>Whenever King Gorger has <strong>50 or more Mind Points</strong> — checked at the start of its turn and again the moment it gains MP (so a bite that pushes it past 50 activates this in the same round) — it spends 50 MP and grants one random <strong>Wellspring</strong> (Fire, Ice, Earth, Bolt or Air) to the battlefield: every creature's damage of that element is increased by 10 until the start of King Gorger's next turn. Only one Wellspring from King Gorger exists at a time.</p>",
          "effect_table": {
            "0": {
              "$deleted": false,
              "chain_steps": "eo_spend,eo_surge",
              "effect_kind": "chain",
              "effect_label": "eo_chain"
            },
            "1": {
              "$deleted": false,
              "consume_amount": "50",
              "consume_resource": "mp",
              "effect_kind": "consume_resource",
              "effect_label": "eo_spend",
              "on_empty": "abort",
              "target_ref": "self"
            },
