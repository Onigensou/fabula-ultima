        "1": {
          "$deleted": false,
          "details": "<p>This creature is always inflicted with <img src=\"https://assets.forge-vtt.com/610d918102e7ac281373ffcb/Buff%20Icon/Zombie.png\" alt=\"\" width=\"21\" height=\"21\"><strong>@UUID[JournalEntry.RZIAnKw95vY6yh2W]{Zombie}</strong></p>",
