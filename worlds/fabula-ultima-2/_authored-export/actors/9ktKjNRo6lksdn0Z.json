      "other_list": {
        "0": {
          "$deleted": false,
          "details": "<p>Summon <strong>1 Zombie</strong> to the battlefield.</p>\n<p>There may be up to 3 Zombies on the battlefield at the same time.</p>\n<p>If the Carrion Lord is in <img src=\"https://assets.forge-vtt.com/610d918102e7ac281373ffcb/Skill%20Icon/FFXIVIcons%20Battle(PvE)/08_DRG/blood_for_blood.png\" alt=\"\" width=\"21\" height=\"21\"><strong>@UUID[JournalEntry.GJevbCPM8cffm1QM]{Crisis},&nbsp;</strong>Summon <strong>2 Zombie</strong> instead.</p>",
          "icon": "",
          "other_name": "Raise Dead",
          "roll": ""
        },
        "1": {
          "$deleted": false,
          "details": "<p>Reduce a Zombie to <strong>0 HP,&nbsp;</strong>then gain its remaining HP as MP.</p>",
          "icon": "",
          "other_name": "Feast",
          "roll": ""
        },
        "2": {
          "$deleted": false,
          "details": "<p>All Zombies becomes <img src=\"https://assets.forge-vtt.com/610d918102e7ac281373ffcb/Skill%20Icon/FFXIVIcons%20Battle(PvE)/14_SMN/summon_carbuncle.png\" alt=\"\" width=\"21\" height=\"21\"><strong>@UUID[JournalEntry.0RscV9vkJNM9dVKQ]{Delayed}</strong> for 1 round and their attacks gain <img src=\"https://assets.forge-vtt.com/610d918102e7ac281373ffcb/Skill%20Icon/FFXIVIcons%20Battle(PvE)/14_SMN/gouge.png\" alt=\"\" width=\"21\" height=\"21\"><strong>@UUID[JournalEntry.noUOPxPoZq65yYxV]{Chain (2)}</strong></p>",
          "icon": "",
          "other_name": "Marching Orders",
          "roll": ""
        },
        "3": {
          "$deleted": false,
          "details": "<p>All Zombies on the field immediately perform a <strong>Free Attack</strong> on a target.</p>",
          "icon": "",
          "other_name": "Attack Orders",
          "roll": ""
        },
        "4": {
          "$deleted": false,
          "details": "<p>All Zombies on the field immediately perform the <strong>【Guard】</strong>actions and <strong>【Cover】</strong>the Carrion Lord.</p>",
          "icon": "",
          "other_name": "Defense Orders",
          "roll": ""
        },
        "5": {
          "$deleted": false,
          "details": "<p>Deals <strong>【10 x the numbers of creatures afflicted with <img src=\"https://assets.forge-vtt.com/610d918102e7ac281373ffcb/Buff%20Icon/Zombie.png\" alt=\"\" width=\"21\" height=\"21\">@UUID[JournalEntry.RZIAnKw95vY6yh2W]{Zombie} 】</strong>Dark damage to target creature.</p>",
          "icon": "",
          "other_name": "💥 Biohazard",
          "roll": ""
        }
      },
