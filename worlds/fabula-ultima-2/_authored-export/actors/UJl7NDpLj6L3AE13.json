          "animation_damage_timing_offset": "0",
          "animation_damage_timing_options": "default",
          "animation_script": "<p>// @engine:pseudo</p><p>(async () => {</p><p>  console.log(\"[ONI][PseudoSmoke] START\", {</p><p>    attackerUuid: payload?.meta?.attackerUuid ?? payload?.attackerUuid,</p><p>    targetsCount: targets?.length ?? 0</p><p>  });</p><p>  if (!canvas?.ready) {</p><p>    console.warn(\"[ONI][PseudoSmoke] canvas not ready\");</p><p>    return;</p><p>  }</p><p>  // Simple per-client guard</p><p>  if (window.ONI_PSEUDO_SMOKE_RUNNING) {</p><p>    console.warn(\"[ONI][PseudoSmoke] already running, skip\");</p><p>    return;</p><p>  }</p><p>  window.ONI_PSEUDO_SMOKE_RUNNING = true;</p><p>  const wait = (ms) => new Promise(r => setTimeout(r, ms));</p><p>  // --- Resolve attacker token from UUID ---</p><p>  const attackerUuid = payload?.meta?.attackerUuid ?? payload?.attackerUuid;</p><p>  const attackerDoc = attackerUuid ? await fromUuid(attackerUuid) : null;</p><p>  const attacker = attackerDoc?.object ?? attackerDoc; // Token placeable if rendered</p><p>  const defender = targets?.[0];</p><p>  if (!attacker || !defender) {</p><p>    console.warn(\"[ONI][PseudoSmoke] Missing attacker/defender\", { attackerUuid, attacker, defender, targets });</p><p>    window.ONI_PSEUDO_SMOKE_RUNNING = false;</p><p>    return;</p><p>  }</p><p>  const baseObj = attacker.mesh ?? attacker.icon;</p><p>  if (!baseObj?.texture) {</p><p>    console.warn(\"[ONI][PseudoSmoke] attacker has no base texture (mesh/icon missing)\", { attacker, baseObj });</p><p>    window.ONI_PSEUDO_SMOKE_RUNNING = false;</p><p>    return;</p><p>  }</p><p>  const originalTokenVisible = attacker.visible;</p><p>  const originalMeshVisible  = baseObj.visible;</p><p>  let sprite;</p><p>  try {</p><p>    // Clone sprite from existing token texture (no loadTexture)</p><p>    sprite = new PIXI.Sprite(baseObj.texture);</p><p>    sprite.anchor.set(0.5);</p><p>    sprite.x = attacker.center.x;</p><p>    sprite.y = attacker.center.y;</p><p>    sprite.width  = baseObj.width;</p><p>    sprite.height = baseObj.height;</p><p>    sprite.zIndex = 1000;</p><p>    canvas.stage.sortableChildren = true;</p><p>    canvas.stage.addChild(sprite);</p><p>    canvas.stage.sortChildren();</p><p>    // Hide real token locally</p><p>    baseObj.visible = false;</p><p>    attacker.visible = false;</p><p>    // Move toward defender (simple linear tween)</p><p>    const startX = sprite.x;</p><p>    const startY = sprite.y;</p><p>    const endX = defender.center.x;</p><p>    const endY = defender.center.y;</p><p>    const duration = 400;</p><p>    const startTime = performance.now();</p><p>    const ticker = canvas.app.ticker;</p><p>    await new Promise(resolve => {</p><p>      const step = () => {</p><p>        const t = Math.min((performance.now() - startTime) / duration, 1);</p><p>        sprite.x = startX + (endX - startX) * t;</p><p>        sprite.y = startY + (endY - startY) * t;</p><p>        if (t >= 1) {</p><p>          ticker.remove(step);</p><p>          resolve();</p><p>        }</p><p>      };</p><p>      ticker.add(step);</p><p>    });</p><p>    await wait(150);</p><p>    // Return</p><p>    const startTime2 = performance.now();</p><p>    await new Promise(resolve => {</p><p>      const step = () => {</p><p>        const t = Math.min((performance.now() - startTime2) / duration, 1);</p><p>        sprite.x = endX + (startX - endX) * t;</p><p>        sprite.y = endY + (startY - endY) * t;</p><p>        if (t >= 1) {</p><p>          ticker.remove(step);</p><p>          resolve();</p><p>        }</p><p>      };</p><p>      ticker.add(step);</p><p>    });</p><p>    console.log(\"[ONI][PseudoSmoke] DONE OK\");</p><p>  } catch (e) {</p><p>    console.error(\"[ONI][PseudoSmoke] ERROR\", e);</p><p>  } finally {</p><p>    // Cleanup</p><p>    try {</p><p>      if (sprite) {</p><p>        canvas.stage.removeChild(sprite);</p><p>        sprite.destroy();</p><p>      }</p><p>    } catch (_) {}</p><p>    baseObj.visible = originalMeshVisible;</p><p>    attacker.visible = originalTokenVisible;</p><p>    window.ONI_PSEUDO_SMOKE_RUNNING = false;</p><p>  }</p><p>})();</p><p></p>",
