      "npc_rank": "",
      "other_list": {
        "0": {
          "$deleted": false,
          "details": "<p>Cultist strangler strangle up it's <img src=\"https://assets.forge-vtt.com/610d918102e7ac281373ffcb/Buff%20Icon/Bludgeon.png\" alt=\"\" width=\"21\" height=\"21\">@UUID[JournalEntry.FV8JefaHsehzgXR7]{Grappled} target(s).</p>\n<p>Strangled target also <img src=\"https://assets.forge-vtt.com/610d918102e7ac281373ffcb/Buff%20Icon/Blind.png\" width=\"21\" height=\"21\">@UUID[JournalEntry.rBnvYhLfmrVZDdoW]{Blind}<br>All creatures gain +2 accuracy bonus against strangled target.</p>\n<p>&nbsp;</p>\n<p>This debuff persists until the end of Strangler's next turn or when the targets grapple end.</p>",
          "icon": "",
          "other_name": "Strangle",
          "roll": ""
        }
