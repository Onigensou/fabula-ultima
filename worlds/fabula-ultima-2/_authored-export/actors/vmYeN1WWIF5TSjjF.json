e) =&gt; {</p><p>    let settled = false;</p><p>    const timer = setTimeout(() =&gt; { if (settled) return; settled = true; Hooks.off(hookName, h); resolve({ ok: false, timeout: true }); }, timeoutMs);</p><p>    const h = (d) =&gt; { if (settled) return; settled = true; clearTimeout(timer); Hooks.off(hookName, h); resolve(d ?? { ok: true }); };</p><p>    Hooks.on(hookName, h);</p><p>  });</p><p>}</p><p>function emitLocal(n, d) { try { Hooks.callAll(n, d); } catch (_) {} }</p><p></p><p>const scriptSource = String.raw`</p><p>const cfg = ctx.params.cfg || {};</p><p>const A = ctx.params.assets || {};</p><p>const caster = ctx.casterToken;</p><p>const tgts = (ctx.targetTokens || []).filter(t =&gt; t &amp;&amp; t.center);</p><p>const prime = tgts[0] || null;</p><p>const S = oni.screenLive();</p><p>const E = oni.EASE;</p><p>const ctr = (t) =&gt; (t &amp;&amp; t.center) ? t.center : { x: 0, y: 0 };</p><p>const home = caster ? { x: caster.center.x, y: caster.center.y } : { x: 0, y: 0 };</p><p>function centroid(list) {</p><p>  if (!list.length) return home;</p><p>  let x = 0, y = 0;</p><p>  for (const t of list) { const c = ctr(t); x += c.x; y += c.y; }</p><p>  return { x: x / list.length, y: y / list.length };</p><p>}</p><p>// Centre of the authored play area (the v2 conflict scene stage rect).</p><p>// A pull-back should frame the arena, so it wants a FIXED point: aiming at</p><p>// the caster turns a zoom-out into a pan, and aiming at a centroid makes the</p><p>// framing drift with wherever the combatants happen to be standing.</p><p>function stageCentre() {</p><p>  const f = canvas.scene &amp;&amp; canvas.scene.flags ? canvas.scene.flags['fabula-ultima-companion'] : null;</p><p>  const sr = f &amp;&amp; f.conflict ? f.conflict.stage : null;</p><p>  if (sr) return { x: sr.x + sr.w / 2, y: sr.y + sr.h / 2 };</p><p>  return centroid(tgts.concat(caster ? [caster] : []));</p><p>}</p><p>function playSfx(k, v) { if (!cfg[k]) return; oni.sfx(cfg[k], { volume: cfg[v] == null ? 0.6 : cfg[v], fadeAfter: cfg[k + 'Fade'] || 0, fadeMs: cfg[k + 'FadeMs'] || 400 }); }</p><p>async function fxWebm(url, x, y, o) {</p><p>  if (!url) return null;</p><p>  o = o || {};</p><p>  return oni.webm(url, { size: o.size || S.wLen(320), x: x, y: y, angle: o.angle || 0,</p><p>    alpha: o.alpha == null ? 1 : o.alpha, zIndex: o.z || 95000, parent: o.parent || null });</p><p>}</p><p>async function fxBeam(url, from, to, o) {</p><p>  if (!url) return null;</p><p>  o = o || {};</p><p>  const dist = Math.hypot(to.x - from.x, to.y - from.y);</p><p>  const ang = Math.atan2(to.y - from.y, to.x - from.x);</p><p>  const r = await oni.webm(url, { size: dist, x: from.x, y: from.y, parent: o.parent || null, zIndex: o.z || 95000 });</p><p>  if (!r || !r.sprite) return null;</p><p>  const sp = r.sprite;</p><p>  sp.anchor.set(0, 0.5);</p><p>  sp.width = dist * (o.lengthScale || 1);</p><p>  sp.height = dist * (o.thickness || 0.25);</p><p>  sp.position.set(from.x, from.y);</p><p>  sp.rotation = ang;</p><p>  return r;</p><p>}</p><p>let fired = false;</p><p>function done() { if (fired) return; fired = true; oni.fireDone(); }</p><p>async function shakeTarget(t, ms, amp) {</p><p>  if (!t) return;</p><p>  const spr = oni.cloneToken(t);</p><p>  if (!spr) return;</p><p>  const restore = oni.hideToken(t);</p><p>  const c = ctr(t);</p><p>  await oni.tween({ from: 0, to: 1, duration: ms, ease: E.linear, onUpdate: (v) =&gt; {</p><p>    const decay = 1 - v;</p><p>    spr.position.set(c.x + (Math.random() * 2 - 1) * amp * decay, c.y + (Math.random() * 2 - 1) * amp * decay);</p><p>  } });</p><p>  spr.position.set(c.x, c.y);</p><p>  restore();</p><p>  try { spr.destroy(); } catch (e) {}</p><p>}</p><p>function streak(x1, y1, x2, y2, color, width, host) {</p><p>  const g = new PIXI.Graphics();</p><p>  g.lineStyle({ width: width, color: color, alpha: 1, cap: 'round' });</p><p>  g.moveTo(x1, y1); g.lineTo(x2, y2);</p><p>  g.blendMode = PIXI.BLEND_MODES.ADD;</p><p>  (host || canvas.stage).addChild(g);</p><p>  return g;</p><p>}</p><p></p><p>if (!caster) { done(); return; }</p><p>const host = oni.layer({ zIndex: 93000 });</p><p>const spots = cfg.at === 'targets' &amp;&amp; tgts.length ? tgts.map(ctr) : [home];</p><p>playSfx('sfx', 'sfxVol');</p><p></p><p>if (cfg.gatherMs &gt; 0) {</p><p>  await Promise.all(spots.map((p) =&gt; oni.particles({ x: p.x, y: p.y,</p><p>    count: cfg.gatherCount, color: cfg.color, size: 12,</p><p>    radius: S.wLen(cfg.gatherRadius), life: cfg.gatherMs, mode: 'gather',</p><p>    blend: PIXI.BLEND_MODES.ADD, parent: host, ease: E.inQuad })));</p><p>}</p><p></p><p>if (cfg.flash) oni.domFlash({ color: cfg.flashColor, alpha: cfg.flashAlpha, fadeIn: 120, hold: 60, fadeOut: 380 });</p><p>if (cfg.screenshakeMs &gt; 0) oni.screenshake({ duration: cfg.screenshakeMs, intensity: cfg.screenshakeAmp });</p><p></p><p>const rings = [];</p><p>if (cfg.ring) {</p><p>  for (const p of spots) {</p><p>    const g = new PIXI.Graphics();</p><p>    g.blendMode = PIXI.BLEND_MODES.ADD;</p><p>    host.addChild(g);</p><p>    const col = cfg.ringColor == null ? cfg.color : cfg.ringColor;</p><p>    rings.push(oni.tween({ from: 0, to: 1, duration: cfg.ringMs, ease: E.outQuad, onUpdate: (v) =&gt; {</p><p>      g.clear();</p><p>      g.lineStyle({ width: S.wLen(cfg.ringWidth) * (1 - v * 0.6), color: col, alpha: 1 - v });</p><p>      g.drawCircle(p.x, p.y, S.wLen(cfg.ringRadius) * v);</p><p>    }, onComplete: () =&gt; { try { g.destroy(); } catch (e) {} } }));</p><p>  }</p><p>}</p><p></p><p>// Needles fly from the CASTER regardless of where the burst lands — the</p><p>// quills come off the creature, not off the people they hit.</p><p>const needles = [];</p><p>if (cfg.needles &gt; 0) {</p><p>  const ncol = cfg.needleColor == null ? cfg.color : cfg.needleColor;</p><p>  for (let i = 0; i &lt; cfg.needles; i++) {</p><p>    const a = Math.random() * Math.PI * 2;</p><p>    const reach = S.wLen(cfg.needleReach) * (0.45 + Math.random() * 0.85);</p><p>    const len = S.wLen(cfg.needleLen) * (0.6 + Math.random() * 0.7);</p><p>    const g = new PIXI.Graphics();</p><p>    g.blendMode = PIXI.BLEND_MODES.ADD;</p><p>    host.addChild(g);</p><p>    needles.push(oni.tween({ from: 0, to: 1, duration: cfg.needleMs * (0.7 + Math.random() * 0.6), ease: E.outQuad, onUpdate: (v) =&gt; {</p><p>      const hx = home.x + Math.cos(a) * reach * v, hy = home.y + Math.sin(a) * reach * v;</p><p>      g.clear();</p><p>      g.lineStyle({ width: S.wLen(cfg.needleWidth) * (1 - v * 0.5), color: ncol, alpha: 1 - v * 0.85, cap: 'round' });</p><p>      g.moveTo(hx - Math.cos(a) * len, hy - Math.sin(a) * len);</p><p>      g.lineTo(hx, hy);</p><p>    }, onComplete: () =&gt; { try { g.destroy(); } catch (e) {} } }));</p><p>  }</p><p>}</p><p></p><p>const bursts = spots.map((p) =&gt; oni.particles({ x: p.x, y: p.y,</p><p>  count: cfg.count, color: cfg.color, size: cfg.size,</p><p>  radius: S.wLen(cfg.radius), life: cfg.life,</p><p>  blend: PIXI.BLEND_MODES.ADD, parent: host }));</p><p></p><p>const shakes = [];</p><p>if (cfg.shake &amp;&amp; cfg.shakeMs &gt; 0) for (const tk of tgts) shakes.push(shakeTarget(tk, cfg.shakeMs, S.wLen(cfg.shakeAmp)));</p><p>if (cfg.donePhase === 'impact') done();</p><p>await Promise.all(rings.concat(bursts, shakes, needles));</p><p>done();</p><p>`;</p><p></p><p>try {</p><p>  emitLocal('oni:animationStart', { type: ANIM_KEY, sceneId: canvas.scene?.id ?? null });</p><p>  const waitDone = onceHook(doneHook, CFG.totalTimeoutMs || 15000);</p><p>  await game.ONI.pseudo.play({</p><p>    scriptId: ANIM_KEY,</p><p>    scriptSource,</p><p>    casterTokenUuid: sourceToken?.document?.uuid ?? null,</p><p>    targetTokenUuids: partyTargets.map(t =&gt; t.document.uuid),</p><p>    params: { doneHook, cfg: CFG, assets: ASSETS },</p><p>    meta: { source: \"Venomstone Spines\" },</p><p>  });</p><p>  const result = await waitDone;</p><p>  if (!result?.ok) console.warn(TAG, 'pseudo non-OK / timeout', result);</p><p>} catch (err) {</p><p>  console.error(TAG, 'orchestration crashed', err);</p><p>} finally {</p><p>  emitLocal('oni:animationEnd', { type: ANIM_KEY, timestamp: Date.now() });</p><p>}</p><p></p><p>})();</p>",
