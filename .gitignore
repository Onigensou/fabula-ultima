# Ignore everything in Foundry Data by default
/*

# Keep this gitignore file
!/.gitignore

# -----------------------------
# Track only this module
# -----------------------------

!/modules/
/modules/*
!/modules/fabula-ultima-companion/
!/modules/fabula-ultima-companion/**

# Ignore old nested Git backup if it exists
/modules/fabula-ultima-companion/.git_BACKUP/

# -----------------------------
# Track only this world
# -----------------------------

!/worlds/
/worlds/*
!/worlds/fabula-ultima-2/
!/worlds/fabula-ultima-2/**

# Do not track world assets (large binary files)
/worlds/fabula-ultima-2/assets/

# Do not track live world session data (LevelDB - binary, always changing)
# This covers actors, items, scenes, fog, combat, chat, etc. in the live world.
# Track game objects via JSON-format compendium packs instead (see below).
/worlds/fabula-ultima-2/data/

# -----------------------------
# Ignore LevelDB runtime files everywhere in world packs
# Packs should use "format": "json" in world.json so only .json files appear here.
# -----------------------------

**/*.ldb
**/MANIFEST-*
**/CURRENT
**/LOCK
**/LOG
**/LOG.old

# Numbered LevelDB write-ahead logs (e.g. 001234.log)
# Note: does NOT ignore module script .js files
worlds/fabula-ultima-2/packs/**/*.log

# -----------------------------
# Ignore archive/temp files
# -----------------------------

*.zip
*.rar
*.7z
*.tmp
*.temp
*.lock

.DS_Store
Thumbs.db
