# LevelDB files — mark as binary to prevent line-ending conversion.
# CURRENT and MANIFEST-* are plain-text pointers but LevelDB reads them
# byte-exact; CRLF conversion would corrupt the database on a cross-OS pull.
*.ldb      binary
**/CURRENT binary
**/MANIFEST-* binary

# Authored-content JSON export (world-export tool) — pin to LF so autocrlf
# doesn't rewrite every line and bury real changes in line-ending noise.
worlds/*/_authored-export/**/*.json text eol=lf

# Git hooks MUST stay LF — a CRLF shebang breaks `/bin/sh` on Unix/Git Bash.
tools/safe-edit/hooks/* text eol=lf
