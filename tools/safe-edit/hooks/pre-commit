#!/bin/sh
# world-export pre-commit gate.
#
# When a commit stages this world's LevelDB data, regenerate the human-readable
# authored-content export and BLOCK the commit if any document — or any skill
# inside an existing actor — would be lost. This is the tripwire that makes the
# Fafnir-style silent wipe (committed binary LevelDB, no reviewable diff)
# impossible to ship by accident.
#
# Install (per clone — git config is not shared via the repo):
#     git config core.hooksPath tools/safe-edit/hooks
# Disable for one commit:  git commit --no-verify
# Disable entirely:        git config --unset core.hooksPath
#
# See tools/safe-edit/bin/world-export.js for the tool itself.

WORLD=fabula-ultima-2

# ── raw-NUL guard (runs on EVERY commit, world data or not) ──────────────────
# A single NUL byte makes ripgrep skip the whole file in content searches with no
# error, so the file silently vanishes from grep. See check-no-nul.js for the
# 2026-08-09 case that motivated it (the core engine file was invisible).
if ! node tools/safe-edit/hooks/check-no-nul.js; then
  exit 1
fi

# Only act when this commit actually touches the world's LevelDB data.
if ! git diff --cached --name-only | grep -q "^worlds/${WORLD}/data/"; then
  exit 0
fi

# Which data collections did the user stage? We re-stage exactly these after the
# export, since opening the LevelDB to read it renumbers the shards (LevelDB
# compaction on close) — without re-staging, the commit would capture a manifest
# the export just superseded. We never widen the user's chosen scope.
staged_cols=$(git diff --cached --name-only \
  | sed -n "s#^worlds/${WORLD}/data/\([^/]*\)/.*#\1#p" | sort -u)

echo "[world-export] world data staged — regenerating authored-content export…"
node tools/safe-edit/bin/world-export.js check --world "$WORLD"
status=$?

if [ "$status" -eq 3 ]; then
  echo ""
  echo "[world-export] ⛔ Foundry appears to be running (LevelDB locked)."
  echo "  Close the world before committing its data, then commit again."
  exit 1
elif [ "$status" -ne 0 ]; then
  echo ""
  echo "[world-export] ⛔ commit blocked: authored content would be LOST (see removals above)."
  echo "  If the removal is intentional, re-run with:  git commit --no-verify"
  echo "  Otherwise restore the dropped documents before committing."
  exit 1
fi

# Refresh the data collections the export just renumbered, and keep the JSON
# export in lock-step with the LevelDB being committed.
for col in $staged_cols; do
  git add "worlds/${WORLD}/data/${col}"
done
git add "worlds/${WORLD}/_authored-export"

# Manifest-integrity gate. Every LevelDB store's CURRENT must name a MANIFEST-*
# that is ALSO present in the tree being committed (read from the index, ":path",
# NOT the working dir — the working dir can look fine while the commit is missing
# the file). A dangling CURRENT means the store won't open on pull: the world
# breaks for the co-dev with no content actually lost. Root cause seen 2026-07-20
# (commit 6737e5c3): the co-dev-owned stores are gitignored-for-new-files and held
# by `git update-index --skip-worktree`; when that bit is cleared (e.g. by the
# `git reset --hard` in an overlay merge) a broad `git add` stages their CURRENT
# bump + old-MANIFEST delete, while the NEW manifest is gitignored and never added.
# This runs on git objects only, so it also catches it while Foundry is open.
manifest_bad=""
stores=$(git ls-files "worlds/${WORLD}/data" "worlds/${WORLD}/packs" \
  | sed -n "s#^\(worlds/${WORLD}/\(data\|packs\)/[^/]*\)/CURRENT\$#\1#p" | sort -u)
for store in $stores; do
  cur=$(git show ":${store}/CURRENT" 2>/dev/null | tr -d '\r\n')
  [ -z "$cur" ] && continue
  if ! git cat-file -e ":${store}/${cur}" 2>/dev/null; then
    manifest_bad="${manifest_bad}\n  ✗ ${store}/CURRENT -> ${cur} (NOT in commit)"
  fi
done
if [ -n "$manifest_bad" ]; then
  echo ""
  echo "[world-export] ⛔ commit blocked: dangling LevelDB manifest pointer(s):"
  printf '%b\n' "$manifest_bad"
  echo "  A store's CURRENT names a MANIFEST-* not staged in this commit; the world"
  echo "  will fail to open on pull. Likely cause: skip-worktree was cleared and a"
  echo "  broad 'git add' staged co-dev-owned store churn whose new manifest is"
  echo "  gitignored. Fix: restore each store to HEAD and re-freeze —"
  echo "      git checkout HEAD -- worlds/${WORLD}/data/<store>"
  echo "      git ls-files worlds/${WORLD}/data/<store> | xargs git update-index --skip-worktree"
  echo "  Only bypass with 'git commit --no-verify' if you genuinely intend it."
  exit 1
fi

echo "[world-export] ✓ no losses; manifests intact; export + data re-staged consistently."
exit 0
