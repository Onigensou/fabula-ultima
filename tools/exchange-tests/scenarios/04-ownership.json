{
  "name": "04-ownership",
  "description": "A user cannot mutate another user's entry; GM can override.",
  "scenario": {
    "reset": true,
    "open": {
      "kind": "action_card",
      "boundaryKey": "card-test-004",
      "payload": {},
      "initialTriggers": [ { "key": "creature_takes_damage" } ],
      "eligibleUserIds": ["user-hina", "user-keren", "GM"]
    },
    "script": [
      { "op": "addEntry", "actor": "user-hina", "params": {
          "skillUuid": "Item.hina-skill", "skillName": "Hina's Skill"
      } },
      { "op": "expect", "path": "queue.length", "value": 1 },

      { "op": "expectThrows", "inner": {
          "op": "removeEntry", "actor": "user-keren",
          "entryRef": "byUser", "entryUserId": "user-hina"
      } },
      { "op": "expect", "path": "queue.length", "value": 1 },

      { "op": "removeEntry", "actor": "GM",
        "entryRef": "byUser", "entryUserId": "user-hina"
      },
      { "op": "expect", "path": "queue.length", "value": 0 }
    ],
    "expectations": {
      "finalStatus": "queueing",
      "queueSize": 0
    }
  }
}
