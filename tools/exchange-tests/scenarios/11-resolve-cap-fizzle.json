{
  "name": "11-resolve-cap-fizzle",
  "description": "Entry 1 fires (heals); entry 2 fizzles via capability check (mock Sleep). usedSkillUuids contains only entry 1.",
  "scenario": {
    "reset": true,
    "open": {
      "kind": "action_card",
      "boundaryKey": "card-cap-fizzle",
      "payload": {},
      "initialTriggers": [ { "key": "creature_takes_damage" } ],
      "eligibleUserIds": ["user-hina"]
    },
    "script": [
      { "op": "addEntry", "actor": "user-hina", "params": {
          "skillUuid": "Item.counter-1", "skillName": "Counterattack"
      } },
      { "op": "addEntry", "actor": "user-hina", "params": {
          "skillUuid": "Item.painful-2", "skillName": "Painful Lesson"
      } },
      { "op": "setReady", "actor": "user-hina", "isReady": true },

      { "op": "runResolution", "mockOutcomes": {
          "Item.counter-1": "fire",
          "Item.painful-2": "fizzle:capability"
      } }
    ],
    "expectations": {
      "finalStatus": "closed",
      "usedSkillUuids": ["Item.counter-1"]
    }
  }
}
