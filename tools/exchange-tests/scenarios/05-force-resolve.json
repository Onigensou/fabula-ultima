{
  "name": "05-force-resolve",
  "description": "A non-GM user can force-resolve only when every OTHER eligible user has Readied. GM can always force-resolve.",
  "scenario": {
    "reset": true,
    "open": {
      "kind": "action_card",
      "boundaryKey": "card-test-005",
      "payload": {},
      "initialTriggers": [ { "key": "creature_takes_damage" } ],
      "eligibleUserIds": ["user-hina", "user-keren", "GM"]
    },
    "script": [
      { "op": "expectThrows", "inner": {
          "op": "forceResolve", "actor": "user-hina"
      } },

      { "op": "setReady", "actor": "user-keren", "isReady": true },
      { "op": "setReady", "actor": "GM", "isReady": true },

      { "op": "forceResolve", "actor": "user-hina" },
      { "op": "expect", "path": "status", "value": "resolving" }
    ],
    "expectations": {
      "finalStatus": "resolving",
      "queueSize": 0
    }
  }
}
