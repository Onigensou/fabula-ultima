{
  "name": "12-resolve-trigger-fizzle",
  "description": "Entry fizzles because triggerRechecker says trigger no longer matches (e.g. healed back over crisis threshold).",
  "scenario": {
    "reset": true,
    "open": {
      "kind": "action_card",
      "boundaryKey": "card-trigger-fizzle",
      "payload": {},
      "initialTriggers": [ { "key": "creature_enter_crisis" } ],
      "eligibleUserIds": ["user-hina"]
    },
    "script": [
      { "op": "addEntry", "actor": "user-hina", "params": {
          "skillUuid": "Item.heart-of-darkness",
          "skillName": "Heart of Darkness",
          "sourceTriggerKey": "creature_enter_crisis"
      } },
      { "op": "setReady", "actor": "user-hina", "isReady": true },

      { "op": "runResolution", "mockOutcomes": {
          "Item.heart-of-darkness": "fizzle:trigger"
      } }
    ],
    "expectations": {
      "finalStatus": "closed",
      "usedSkillUuids": []
    }
  }
}
