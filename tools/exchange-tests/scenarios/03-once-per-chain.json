{
  "name": "03-once-per-chain",
  "description": "Same skillUuid cannot be queued twice in one Exchange (once-per-chain rule).",
  "scenario": {
    "reset": true,
    "open": {
      "kind": "lifecycle",
      "boundaryKey": "turn_start:tk-hina",
      "payload": {},
      "initialTriggers": [ { "key": "turn_start", "payload": { "tokenId": "tk-hina" } } ],
      "eligibleUserIds": ["user-hina"]
    },
    "script": [
      { "op": "addEntry", "actor": "user-hina", "params": {
          "skillUuid": "Item.dup", "skillName": "Dup Skill"
      } },
      { "op": "expect", "path": "queue.length", "value": 1 },

      { "op": "expectThrows", "inner": {
          "op": "addEntry", "actor": "user-hina", "params": {
              "skillUuid": "Item.dup", "skillName": "Dup Skill (second copy)"
          }
      } },
      { "op": "expect", "path": "queue.length", "value": 1 }
    ],
    "expectations": {
      "finalStatus": "queueing",
      "queueSize": 1
    }
  }
}
