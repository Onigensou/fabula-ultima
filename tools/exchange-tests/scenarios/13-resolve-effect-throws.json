{
  "name": "13-resolve-effect-throws",
  "description": "Effect runner throws for one entry; engine catches and logs errored; next entry still resolves; phase closes cleanly.",
  "scenario": {
    "reset": true,
    "open": {
      "kind": "action_card",
      "boundaryKey": "card-effect-throws",
      "payload": {},
      "initialTriggers": [ { "key": "creature_takes_damage" } ],
      "eligibleUserIds": ["user-hina"]
    },
    "script": [
      { "op": "addEntry", "actor": "user-hina", "params": {
          "skillUuid": "Item.broken-skill", "skillName": "Broken Skill"
      } },
      { "op": "addEntry", "actor": "user-hina", "params": {
          "skillUuid": "Item.ok-skill", "skillName": "OK Skill"
      } },
      { "op": "setReady", "actor": "user-hina", "isReady": true },

      { "op": "runResolution", "mockOutcomes": {
          "Item.broken-skill": "throw:effect",
          "Item.ok-skill":     "fire"
      } }
    ],
    "expectations": {
      "finalStatus": "closed",
      "usedSkillUuids": ["Item.ok-skill"]
    }
  }
}
